# MurphAI application environment.
# Use "development" locally and "production" for a deployed service.
ENVIRONMENT=development

# PostgreSQL connection string used by the MurphAI backend.
DATABASE_URL=postgresql+psycopg://murphai:your_password@postgres:5432/murphai

# Long random secret used to sign and validate JWT access tokens.
# Never commit the real production value to Git.
SECRET_KEY=replace_with_a_long_random_secret

# JWT signing algorithm.
ALGORITHM=HS256

# Comma-separated browser origins allowed to access the API.
# Example for local frontend development:
CORS_ORIGINS=http://localhost:3000

# MLflow Tracking Server URI.
#
# Leave empty for local development. MurphAI will then use
# the local SQLite database configured by MLFLOW_DB_PATH.
#
# Production should provide the internal MLflow Tracking Server,
# for example:
# MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_URI=
MLFLOW_DB_PATH=

# MLflow model artifact storage directory.
# Leave unset locally to use the project default,
# or set an explicit path such as /app/mlruns in Docker.
MLFLOW_ARTIFACT_ROOT=